[Unit]
Description=Rural Basic Income one-shot data worker
Wants=network-online.target
After=network-online.target
Requires=rbi-postgres.service
After=rbi-postgres.service

[Container]
ContainerName=rbi-worker
Image=localhost/rural-basic-income:0.2.0
Pod=rbi-pod.pod
EnvironmentFile=/home/yum_ki/Dropbox/농어촌기본소득/Rural_Basic_Income/.env
Environment=APP_ENV=production
Exec=rbi-worker update --start-period=202501 --end-period=202606

[Service]
Type=oneshot
Restart=no
TimeoutStartSec=12h

[Install]
WantedBy=default.target
