[Unit]
Description=Rural Basic Income web application
Wants=network-online.target
After=network-online.target
Requires=rbi-postgres.service
After=rbi-postgres.service

[Container]
ContainerName=rbi-web
Image=localhost/rural-basic-income:0.3.1
# Port publishing lives in rbi-pod.pod because pod members share one network namespace.
Pod=rbi-pod.pod
EnvironmentFile=/home/yum_ki/Dropbox/농어촌기본소득/Rural_Basic_Income/.env
Environment=APP_ENV=production
Environment=EXPORT_CSV_DIR=/export/csv
Environment=RBI_LATEST_START_PERIOD=202501
Volume=/home/yum_ki/Dropbox/농어촌기본소득/Rural_Basic_Income/export/csv:/export/csv:Z
# Optional manual imports. Override this host path for production as needed.
Volume=/srv/rbi/imports:/imports:ro
Exec=uvicorn rural_basic_income.web.main:app --host 0.0.0.0 --port 8000
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=5).read()"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5

[Service]
Restart=always
TimeoutStartSec=60
