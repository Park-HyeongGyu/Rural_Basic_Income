[Unit]
Description=Rural Basic Income analysis worker
Wants=network-online.target
After=network-online.target
Requires=rbi-postgres.service
After=rbi-postgres.service
Requires=rbi-redis.service
After=rbi-redis.service

[Container]
ContainerName=rbi-analysis
Image=localhost/rural-basic-income:0.3.0
Pod=rbi-pod.pod
EnvironmentFile=/home/yum_ki/Dropbox/농어촌기본소득/Rural_Basic_Income/.env
Environment=APP_ENV=production
Environment=REDIS_URL=redis://127.0.0.1:6379/0
Exec=celery -A rural_basic_income.analysis.celery_app:app worker --loglevel=INFO --concurrency=1 --prefetch-multiplier=1

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
