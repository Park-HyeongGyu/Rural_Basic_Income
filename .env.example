# Copy to .env for local development. Do not commit real secrets.

APP_ENV=development

POSTGRES_USER=rbi
POSTGRES_PASSWORD=passrbi
POSTGRES_DB=rural_basic_income
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://rbi:passrbi@127.0.0.1:5432/rural_basic_income

# KOSIS OpenAPI
KOSIS_API_KEY=

# KEPCO Bigdata OpenAPI
KEPCO_API_KEY=

# data.go.kr OpenAPI
DATA_GO_KR_API_KEY=

# Telegram notifications for long-running worker commands.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_SUCCESS_TELEGRAM=false
ENABLE_FAILURE_TELEGRAM=false

# Flat data export
EXPORT_CSV_DIR=/export/csv

# Manual import files are mounted by Quadlet, for example:
#   /srv/rbi/imports on the host -> /imports in rbi-web

# rbi update --latest scans from this month when --start-period is omitted.
RBI_LATEST_START_PERIOD=202501

# Redis and Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ANALYSIS_CACHE_TTL_SECONDS=2592000
ANALYSIS_TASK_SOFT_TIME_LIMIT_SECONDS=1200
ANALYSIS_TASK_TIME_LIMIT_SECONDS=1800
ANALYSIS_RUNNING_LOCK_TTL_SECONDS=2100
ANALYSIS_RATE_LIMIT_REQUESTS=300
ANALYSIS_RATE_LIMIT_WINDOW_SECONDS=60
